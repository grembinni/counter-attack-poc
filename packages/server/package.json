{
  "name": "@counter-attack/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "clean": "node --eval \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@counter-attack/shared": "workspace:*",
    "cors": "2.8.6",
    "express": "4.22.2",
    "nanoid": "5.1.11",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "22.19.19",
    "socket.io-client": "4.8.3",
    "tsx": "4.22.3",
    "vitest": "2.1.9"
  }
}
