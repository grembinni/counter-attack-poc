{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["husky"],
  "workspaces": {
    "packages/shared": {
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/server": {
      "project": ["src/**/*.ts"]
    },
    "packages/client": {
      "entry": ["index.html"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts"]
    }
  }
}
